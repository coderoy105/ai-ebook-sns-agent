# Public Supabase values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local development fallback only. Production on Vercel uses Vercel OIDC -> Supabase Edge Function.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# AI provider
# On Vercel, VERCEL_OIDC_TOKEN is injected automatically and AI Gateway is used.
# AI_GATEWAY_API_KEY is optional for non-OIDC environments.
# OPENAI_API_KEY is kept as a local/direct OpenAI fallback.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
OPENAI_PLANNER_MODEL=gpt-5
OPENAI_WRITER_MODEL=gpt-5
OPENAI_EDITOR_MODEL=gpt-5
OPENAI_REVIEWER_MODEL=gpt-5
OPENAI_RESEARCH_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Export typography. Defaults point to a public Noto Sans KR WOFF package.
PDF_FONT_REGULAR_URL=https://cdn.jsdelivr.net/npm/@fontsource/noto-sans-kr@latest/files/noto-sans-kr-korean-400-normal.woff
PDF_FONT_BOLD_URL=https://cdn.jsdelivr.net/npm/@fontsource/noto-sans-kr@latest/files/noto-sans-kr-korean-700-normal.woff

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AI_BOOK_STUDIO_INTERNAL_SECRET=
