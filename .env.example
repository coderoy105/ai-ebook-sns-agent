# Public Supabase values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local development fallback only. Production on Vercel uses Vercel OIDC -> Supabase Edge Function.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Non-Codex AI infrastructure used by legacy embedding/memory helpers.
# Production can use Vercel AI Gateway OIDC; no direct OpenAI API key is required.
AI_GATEWAY_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ChatGPT-managed Codex OAuth worker (server-only; never NEXT_PUBLIC_*)
CODEX_WORKER_URL=
CODEX_WORKER_SHARED_SECRET=

# Export typography. Defaults point to a public Noto Sans KR WOFF package.
PDF_FONT_REGULAR_URL=https://cdn.jsdelivr.net/npm/@fontsource/noto-sans-kr@latest/files/noto-sans-kr-korean-400-normal.woff
PDF_FONT_BOLD_URL=https://cdn.jsdelivr.net/npm/@fontsource/noto-sans-kr@latest/files/noto-sans-kr-korean-700-normal.woff

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AI_BOOK_STUDIO_INTERNAL_SECRET=
